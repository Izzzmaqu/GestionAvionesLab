@model GestionAviones.Model.Avion

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar Avión</h1>

@using (Html.BeginForm("Editar", "GestionAviones", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div class="mb-3">
        @Html.LabelFor(model => model.Nombre)
        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Modelo)
        @Html.EditorFor(model => model.Modelo, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Modelo, "", new { @class = "text-danger" })
    </div>

    <input type="submit" value="Guardar" class="btn btn-warning" />
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}
