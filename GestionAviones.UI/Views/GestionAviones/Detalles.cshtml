@model GestionAviones.Model.Avion

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles del Avión</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
