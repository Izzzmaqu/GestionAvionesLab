@model GestionAviones.Model.Avion

@{
    ViewData["Title"] = "Inactivar";
}

<h1>¿Desea inactivar este avión?</h1>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Modelo)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Modelo)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estado)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estado)</dd>
</dl>

@using (Html.BeginForm("InActivar", "GestionAvionesActivos", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
    <input type="submit" value="Confirmar Inactivar" class="btn btn-danger" />
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
}
